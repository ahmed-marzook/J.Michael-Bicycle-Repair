---
/**
 * PricingCard.astro — docs/DESIGN_SYSTEM.md 4.8.
 *
 * Prices are read from src/data/business.ts and never typed into markup.
 *
 * Emphasis on the adult tier is VISUAL ONLY: a 2px brand-600 border, shadow-2,
 * a 4px accent-400 top rule and a factual "Adult bikes" badge. No transform, no
 * scale, no lift — those overlap neighbouring cards at narrow widths — and no
 * popularity claim, which the brief does not support.
 */
import Star from '../assets/star.svg';
import WhatsAppButton from './WhatsAppButton.astro';
import { business, type PricingTier } from '../data/business';

interface Props {
  tier: PricingTier;
  /** Render the WhatsApp CTA inside the card. */
  withCta?: boolean;
  level?: 'h3' | 'h4';
}

const { tier, withCta = true, level = 'h3' } = Astro.props;
const Heading = level;
const emphasised = tier.isMostCommon;
const highlights = business.pricing.cardHighlights;
---

<li
  class:list={[
    'card flex h-full flex-col overflow-hidden p-0',
    emphasised ? 'card-emphasis' : null,
  ]}
  id={`tier-${tier.id}`}
>
  {emphasised ? <div class="card-emphasis-rule" aria-hidden="true"></div> : null}

  <div class="flex h-full flex-col p-5 md:p-6">
    <div class="flex items-start justify-between gap-3">
      <span class="eyebrow">{tier.category}</span>
      {tier.badge ? <span class="badge">{tier.badge}</span> : null}
    </div>

    <p class="price mt-3">{tier.displayPrice}</p>

    <Heading class="mt-3">{tier.heading}</Heading>
    <p class="mt-1 text-sm text-muted">{tier.summary}</p>

    <hr class="mt-5 border-0 border-t border-border" />

    <ul class="star-list mt-5 grid gap-3 text-sm">
      {
        highlights.map((highlight) => (
          <li>
            <Star
              width={16}
              height={16}
              focusable="false"
              aria-hidden="true"
              class="stars-on-light mt-1 shrink-0"
            />
            <span>{highlight}</span>
          </li>
        ))
      }
    </ul>

    {
      withCta ? (
        <>
          <hr class="mt-5 border-0 border-t border-border" />
          <div class="mt-5 md:mt-auto md:pt-5">
            <WhatsAppButton
              block
              ariaLabel={`WhatsApp ${business.identity.ownerFirstName} about the ${tier.heading} service at ${tier.displayPrice}`}
            />
          </div>
        </>
      ) : null
    }
  </div>
</li>
