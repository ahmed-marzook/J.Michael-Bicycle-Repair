export type IconName = keyof typeof PATHS;

interface Props {
  name: IconName;
  /** CSS pixels. The design system uses 20 or 24 everywhere. */
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const isFilled = (FILLED as readonly string[]).includes(name);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={isFilled ? undefined : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={PATHS[name]}
/>
