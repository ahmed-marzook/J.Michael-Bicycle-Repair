---
/**
 * OpeningHours.astro — the weekly timetable and the live status badge.
 *
 * HOW IT WORKS
 *
 * 1. Build time: the whole table is rendered from the published Google Sheet
 *    (src/lib/hours-sheet.ts). The schedule is real HTML, so it is indexable,
 *    correct with JavaScript off, and correct when Sheets is down.
 * 2. Browser: one fetch re-reads the sheet so a "fully booked today" set an
 *    hour ago shows without a redeploy, and computes the open/closed badge
 *    against the current time.
 *
 * OVERRIDES
 *
 * `status_override` on an hours row is the RECURRING rule for that weekday.
 * The one-off notice and its override live in their own tab and are rendered
 * site-wide by AnnouncementBanner; a one-off beats the recurring rule, and the
 * banner tells this component when it changes.
 *
 * Which day it is cannot be known at build time, so the whole week is carried
 * as data attributes and src/scripts/hours-runtime.ts picks out today's.
 *
 * WHY THE BADGE IS NOT RENDERED STATICALLY
 *
 * "Open now" is true for about eight hours a day. Baked into static HTML it
 * would be a lie for the other sixteen, and a customer who rides across
 * Bletchley to a shut workshop is a worse outcome than a customer who checks
 * the timetable. So the badge starts in a neutral state that is true at any
 * hour, and only becomes OPEN / BUSY / CLOSED once JavaScript has computed it
 * against the real clock. Its box is reserved either way, so nothing shifts.
 *
 * TIME ZONE
 *
 * All comparisons run in Europe/London via Intl, never in the visitor's local
 * time. Someone checking from Spain at 18:00 is looking at a workshop where it
 * is 17:00; `new Date().getHours()` would tell them the wrong thing.
 *
 * COLOUR
 *
 * The brief's example classes (emerald / amber) are not used: this site has
 * its own palette whose contrast ratios were computed and verified, and
 * dropping raw Tailwind hues in would both go off-brand and bypass that work.
 * Open uses the brand green, busy the gold accent, closed the muted neutral.
 */
import { business } from '../data/business';
import { loadHours, HOURS_CSV_URL } from '../lib/hours-sheet';

interface Props {
  /** Pass an empty string to render the timetable with no live update. */
  csvUrl?: string;
  class?: string;
}

const { csvUrl = HOURS_CSV_URL, class: className } = Astro.props;
const { identity, contact } = business;

const { rows } = await loadHours();

/*
 * With no timetable at all (sheet unreachable AND hours still unknown in
 * business.ts) there is nothing honest to tabulate, so fall back to the
 * client's own wording about ringing him.
 */
const hasSchedule = rows.length > 0;
---

<div class={className} id="opening-times" data-opening-hours data-url={csvUrl}>
  {/* Status badge. Neutral until JS computes it — see the header comment. */}
  <p class="hours-status" data-status>
    <span class="hours-status__dot" aria-hidden="true"></span>
    <span data-status-text>Check today's hours below</span>
  </p>

  {
    hasSchedule ? (
      <table class="hours-table mt-5">
        <caption class="sr-only-text">
          Opening hours for {identity.spokenName}, all times UK time
        </caption>
        <thead>
          <tr>
            <th scope="col">Day</th>
            <th scope="col">Hours</th>
            <th scope="col">Notes</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr
              data-day={row.day}
              data-closed={String(row.isClosed)}
              data-open={row.opens ?? ''}
              data-close={row.closes ?? ''}
              data-note={row.note}
              data-override={row.statusOverride}
              class:list={[row.isClosed ? 'is-closed' : null]}
            >
              <th scope="row">
                {row.label}
                {/*
                  The "Today" pill is added by the script. Which day is today
                  cannot be known at build time — the page may be served for
                  weeks — so marking one row here would be wrong six days out
                  of seven.
                */}
              </th>
              <td data-hours-cell>{row.display}</td>
              <td data-note-cell>{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="mt-4">{contact.contactNote}</p>
    )
  }
</div>

<script>
  import { initOpeningHours } from '../scripts/hours-runtime';

  document
    .querySelectorAll<HTMLElement>('[data-opening-hours]')
    .forEach((el) => initOpeningHours(el));
</script>
