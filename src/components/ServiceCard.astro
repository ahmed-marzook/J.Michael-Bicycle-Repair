---
/**
 * ServiceCard.astro — docs/DESIGN_SYSTEM.md 4.7.
 *
 * A static <li>, not a link and not clickable: these cards do not navigate, so
 * they carry no hover affordance at all.
 *
 * The slug-to-icon map is presentation, so it lives here rather than in
 * src/data/business.ts, which holds only client facts.
 */
import Icon, { type IconName } from './Icon.astro';
import type { Service } from '../data/business';

const ICON_FOR_SLUG: Readonly<Record<string, IconName>> = {
  'bicycle-wash': 'sparkles',
  'bike-assembly-and-disassembly': 'package',
  'brake-adjustment': 'disc',
  'custom-bicycle-build': 'bike',
  'derailleur-adjustment': 'link',
  'gear-adjustment': 'cog',
  'headset-adjustment': 'compass',
  'lube-service': 'droplet',
  'safety-inspection': 'shield',
  'shock-service': 'shock',
  'tyre-tube-repair': 'tyre',
  'tune-up': 'wrench',
  'wheel-alignment': 'wheel',
};

interface Props {
  service: Service;
  /** Heading level, so the page outline stays honest. */
  level?: 'h3' | 'h4';
}

const { service, level = 'h3' } = Astro.props;
const Heading = level;
const icon = ICON_FOR_SLUG[service.slug] ?? 'wrench';
---

<li class="card flex h-full flex-col" id={service.slug}>
  <span class="icon-tile mb-4">
    <Icon name={icon} size={24} />
  </span>
  <Heading class="text-h4 font-body font-bold">{service.name}</Heading>
  <p class="mt-3 text-sm">{service.description}</p>
</li>
