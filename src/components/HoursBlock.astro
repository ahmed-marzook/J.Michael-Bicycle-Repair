---
/**
 * HoursBlock.astro
 *
 * `business.hours` is a discriminated union. This component switches on `kind`
 * and is the ONLY place on the site that does so for display:
 *
 *   'byAppointment' — today's honest answer. Renders the client's own wording,
 *     "Call or WhatsApp anytime to arrange an appointment". No empty table of
 *     days is rendered (docs/DESIGN_SYSTEM.md 5.5 step 5), because opening
 *     hours are NOT known and inventing them is forbidden (AGENTS.md 2.1).
 *   'scheduled' — real published hours, rendered as a definition list. The
 *     day-by-day branch exists so that when the client answers, only
 *     src/data/business.ts changes.
 */
import Icon from './Icon.astro';
import { business } from '../data/business';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { hours } = business;

const DAY_LABEL: Readonly<Record<string, string>> = {
  monday: 'Monday',
  tuesday: 'Tuesday',
  wednesday: 'Wednesday',
  thursday: 'Thursday',
  friday: 'Friday',
  saturday: 'Saturday',
  sunday: 'Sunday',
};
---

<div class:list={['note-box', className]}>
  {
    hours.kind === 'byAppointment' ? (
      <>
        <p class="flex items-start gap-3 text-base">
          <Icon name="message" size={20} class="mt-1 shrink-0 text-brand-600" />
          <span>
            <strong class="font-semibold">{hours.message}</strong>
          </span>
        </p>
        <p class="mt-2 text-sm text-muted">{hours.note}</p>
      </>
    ) : (
      <>
        <dl class="grid gap-2">
          {hours.days.map((day) => (
            <div class="flex justify-between gap-4">
              <dt>{DAY_LABEL[day.day] ?? day.day}</dt>
              <dd>
                {day.status === 'closed'
                  ? 'Closed'
                  : day.intervals
                      .map((slot) => `${slot.opens}–${slot.closes}`)
                      .join(', ')}
              </dd>
            </div>
          ))}
        </dl>
        {hours.note ? <p class="mt-3 text-sm text-muted">{hours.note}</p> : null}
      </>
    )
  }
</div>
