---
/**
 * HoursSummary.astro — today's opening hours in one line, for the home page.
 *
 * The full timetable lives on /contact/. Most people arriving on the home page
 * from a Facebook or WhatsApp link want one thing: is he open, and until when.
 * This answers that, and links through for the rest of the week.
 *
 * Which day it is cannot be known at build time — a static page may be served
 * for weeks — so the whole week is rendered as data attributes and the script
 * picks out today. Without JavaScript this degrades to a plain link to the
 * full timetable rather than asserting hours that might be yesterday's.
 *
 * The badge and the "opens tomorrow at 8:30am" line are both computed in
 * Europe/London, so a visitor abroad is told about the workshop's day, not
 * their own.
 */
import { loadHours, HOURS_CSV_URL } from '../lib/hours-sheet';
import Icon from './Icon.astro';

interface Props {
  /** Empty string renders the static summary with no live refresh. */
  csvUrl?: string;
  /** Where "see full opening times" points. */
  href?: string;
  class?: string;
}

const {
  csvUrl = HOURS_CSV_URL,
  href = '/contact/#opening-times',
  class: className,
} = Astro.props;

const { rows } = await loadHours();
---

<div class:list={['hours-summary', className]} data-hours-summary data-url={csvUrl}>
  {/*
    The whole week, carried as data only. Nothing here renders: it is the
    schedule the script reads to work out today without a second request.
  */}
  {
    rows.map((row) => (
      <span
        hidden
        data-day={row.day}
        data-closed={String(row.isClosed)}
        data-open={row.opens ?? ''}
        data-close={row.closes ?? ''}
        data-note={row.note}
        data-override={row.statusOverride}
      />
    ))
  }

  <p class="hours-status" data-status>
    <span class="hours-status__dot" aria-hidden="true"></span>
    <span data-status-text>Opening times</span>
  </p>

  <div class="hours-summary__body">
    {/*
      Filled in by the script. Empty in the HTML rather than guessing a day,
      so a page served on Thursday never claims Monday's hours.
    */}
    <p class="hours-summary__today" data-today-line></p>
    <p class="hours-summary__detail" data-today-detail hidden></p>

    <p class="mt-3">
      <a class="link-standalone" href={href}>
        See full opening times
        <Icon name="chevronRight" size={16} />
      </a>
    </p>
  </div>
</div>

<script>
  import { initHoursSummary } from '../scripts/hours-runtime';

  document
    .querySelectorAll<HTMLElement>('[data-hours-summary]')
    .forEach((el) => initHoursSummary(el));
</script>
