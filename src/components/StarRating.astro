---
/**
 * StarRating.astro — docs/DESIGN_SYSTEM.md 4.10.
 *
 * Five filled five-pointed stars matching the sign's bullet stars. There are no
 * half or empty stars anywhere on this site because the rating is 5.0.
 *
 * The star group is aria-hidden and is preceded by a visually hidden sentence,
 * so a screen reader hears the rating once, as prose, and never "star star
 * star star star".
 */
import Star from '../assets/star.svg';
import { business } from '../data/business';

interface Props {
  /** 'light' = accent-500 on a light surface. 'dark' = accent-300 on brand-900. */
  tone?: 'light' | 'dark';
  size?: number;
  /**
   * Emit the visually hidden sentence. Set false only where the surrounding
   * text already states the rating in full.
   */
  labelled?: boolean;
  /**
   * Score for ONE item, e.g. a single real Google review, rather than the
   * business aggregate. Omit for the aggregate, which is the default and what
   * every trust signal on the site uses.
   *
   * This exists because real reviews arrive with their own ratings: a genuine
   * 4-star review must not be drawn with five stars. Only the stars actually
   * earned are drawn — there are still no empty or half stars anywhere on the
   * site (docs/DESIGN_SYSTEM.md 4.10) — and the hidden label states the score
   * out of `bestRating` so the count is never ambiguous.
   */
  rating?: number;
  class?: string;
}

const {
  tone = 'light',
  size = 20,
  labelled = true,
  rating,
  class: className,
} = Astro.props;

const { aggregate } = business.reviews;
const isSingleReview = rating !== undefined;
const stars = Math.round(isSingleReview ? rating : aggregate.ratingValue);
const label = isSingleReview
  ? `Rated ${stars} out of ${aggregate.bestRating}`
  : `Rated ${aggregate.ratingValue.toFixed(1)} out of ${aggregate.bestRating} from ${aggregate.reviewCount} ${aggregate.sourceLabel} reviews`;

const classes = [
  'inline-flex items-center gap-1',
  tone === 'dark' ? 'stars-on-dark' : 'stars-on-light',
  className,
]
  .filter(Boolean)
  .join(' ');
---

{labelled ? <span class="sr-only-text">{label}</span> : null}
<span class={classes} aria-hidden="true">
  {
    Array.from({ length: stars }).map(() => (
      <Star width={size} height={size} focusable="false" />
    ))
  }
</span>
