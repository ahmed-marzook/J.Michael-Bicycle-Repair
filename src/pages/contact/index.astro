---
/**
 * /contact/ — docs/DESIGN_SYSTEM.md 5.5.
 *
 * WhatsApp first, then phone, text, email, both Facebook pages and the Google
 * listing. Every href is read from src/data/business.ts.
 *
 * There is deliberately NO final CTA band on this page: the whole page is the
 * CTA, and a band would put a third green button in one viewport. There is also
 * no contact form — a form needs a backend, which is out of scope per brief
 * section 10, and a form that fails silently loses enquiries.
 *
 * The mobile WhatsApp bar IS still shown here. Duplicating the CTA is
 * acceptable; missing it is not.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import AddressBlock from '../../components/AddressBlock.astro';
import HoursBlock from '../../components/HoursBlock.astro';
import Icon, { type IconName } from '../../components/Icon.astro';

import MapEmbed from '../../components/MapEmbed.astro';

import { business } from '../../data/business';

const { identity, contact, address, socials } = business;

const facebookPages = socials.filter((social) => social.platform === 'facebook');
const googleListing = socials.find((social) => social.platform === 'google');

interface Channel {
  readonly icon: IconName;
  readonly name: string;
  readonly value: string;
  readonly href: string;
  readonly newTab: boolean;
}

/*
 * Order is load-bearing: WhatsApp is the primary channel and must come first.
 * WhatsApp itself is rendered above this list as the primary button, so the
 * list below starts at phone.
 */
const channels: readonly Channel[] = [
  {
    icon: 'phone',
    name: 'Phone',
    value: contact.phoneDisplay,
    href: contact.telHref,
    newTab: false,
  },
  {
    icon: 'message',
    name: 'Text message',
    value: contact.phoneDisplay,
    href: contact.smsHref,
    newTab: false,
  },
  {
    icon: 'mail',
    name: 'Email',
    value: contact.email,
    href: contact.emailHref,
    newTab: false,
  },
  ...facebookPages.map((page) => ({
    icon: 'facebook' as const,
    name: page.isPrimary ? 'Facebook' : 'Facebook (Bletchley page)',
    value: page.label,
    href: page.url,
    newTab: true,
  })),
  ...(googleListing
    ? [
        {
          icon: 'external' as const,
          name: 'Google listing',
          value: 'Reviews, photos and opening details',
          href: googleListing.url,
          newTab: true,
        },
      ]
    : []),
];

const description = `Contact ${identity.ownerFirstName} at ${identity.legalName} in Bletchley, Milton Keynes. ${contact.contactNote} ${contact.phoneDisplay}.`;
---

<BaseLayout title={`Contact ${identity.ownerFirstName}`} description={description}>
  {/* 2. Intro -------------------------------------------------------------- */}
  <section class="section">
    <div class="container-page">
      <span class="eyebrow mb-3">Contact</span>
      <h1>Contact {identity.ownerFirstName}</h1>
      <p class="lead mt-4 md:mt-5">{contact.contactNote}</p>

      {/* 3. Channels, WhatsApp first ------------------------------------- */}
      <div class="mt-8">
        <WhatsAppButton block class="md:w-auto" />
        <p class="mt-3 text-sm text-muted">
          WhatsApp is the quickest way to reach {identity.ownerFirstName}. Send a
          photo of the bike and he can usually tell you what it needs.
        </p>
      </div>

      <h2 class="mt-10">Every way to reach {identity.ownerFirstName}</h2>

      <ul role="list" class="mt-6 grid gap-4 md:grid-cols-2 md:gap-6">
        {
          channels.map((channel) => (
            <li>
              <a
                class="channel-row"
                href={channel.href}
                target={channel.newTab ? '_blank' : undefined}
                rel={channel.newTab ? 'noopener noreferrer' : undefined}
              >
                <span class="icon-tile" aria-hidden="true">
                  <Icon name={channel.icon} size={24} />
                </span>
                <span>
                  <span class="channel-name block">{channel.name}</span>
                  <span class="channel-value block">{channel.value}</span>
                </span>
                {channel.newTab ? (
                  <span class="sr-only-text">(opens in a new tab)</span>
                ) : null}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 4. Where the workshop is ------------------------------------------------ */}
  <section class="section bg-surface-subtle">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div>
        <SectionHeading
          eyebrow="Find the workshop"
          heading={`${address.street}, ${address.dependentLocality}`}
          lead={`${address.locality}, ${address.region}, ${address.postcode}. Help loading and unloading the bike is always provided.`}
        />
        <AddressBlock class="mt-8" />
      </div>

      {/*
        The real map, open by default. It loads from Google on page load and
        sets Google's cookies; this page and the home page are the only two
        that make a third-party request. The address and the directions button
        above are always available, so this is an extra rather than the only
        way to find the workshop.
      */}
      <MapEmbed />
    </div>
  </section>

  {/* 5. Hours ---------------------------------------------------------------- */}
  <section class="section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Opening times"
        heading="Appointments are arranged directly"
      />
      <HoursBlock class="mt-8 max-w-copy" />
    </div>
  </section>
</BaseLayout>
