# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the value. `.env` is gitignored; this
# example file is the only one that is committed. NEVER commit a real value.
#
# Everything here is used ONLY at build time, on the machine running
# `npm run build`. Nothing in this file is ever sent to the browser or written
# into `dist/`. The built site is pure static files with no runtime config.
#
# All of it is OPTIONAL. With nothing set, `npm run build` still succeeds: it
# prints one warning line and renders the placeholder testimonials from
# src/data/business.ts.
# ---------------------------------------------------------------------------

# The Featurable widget ID for the workshop's Google Business Profile. This is
# what pulls the real Google reviews in at build time
# (src/lib/featurable-reviews.ts).
#
# TODO(client): how to get it — create a free account at https://featurable.com,
# connect the "J.Michael & Co" Google Business Profile, create a Google Reviews
# widget, then open the widget's API tab and copy the widget ID (a UUID, e.g.
# 842ncdd8-0f40-438d-9c...). No API key is needed: the read endpoint
# `https://api.featurable.com/v1/widgets/<id>` is keyed by the widget ID alone.
FEATURABLE_WIDGET_ID=

# Optional. Overrides the API base URL, so the endpoint can be repointed if
# Featurable ever moves it, and so the offline / unreachable path can be
# exercised on demand by aiming it at a dead host. Leave unset in normal use.
# Default: https://api.featurable.com/v1/widgets
FEATURABLE_API_BASE_URL=
